{
  "_comment": "セットアップが取得するものの版と取得元。bootstrap.ps1 と install.py はここだけを見る。URL・wheel・sha256 は 2026-11-25 に存在と一致を確かめた。",
  "python": {
    "version": "3.12.16",
    "build": "20261110",
    "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-pc-windows-msvc-install_only_stripped.tar.gz",
    "sha256": "355ee61b8207b91574491b1c6dc9b0ebb4408fc56bfafe498f3ef439314b52dc",
    "archive_root": "python"
  },
  "node": {
    "version": "24.22.3",
    "url": "https://nodejs.org/dist/v24.22.3/node-v24.22.3-win-x64.zip",
    "sha256": "e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f",
    "archive_root": "node-v24.22.3-win-x64"
  },
  "torch": {
    "_comment": "{device} は AMD の gfx ターゲット（例 gfx1201）に置き換わる。torchvision は解析で使わないので入れない。",
    "defaults": {
      "amd": "rocm-10.2.0",
      "nvidia": "cu132",
      "cpu": "cpu"
    },
    "profiles": {
      "rocm-10.2.0": {
        "backend": "amd",
        "label": "AMD ROCm 10.2.0 / PyTorch 2.15.0 (stable.repo.amd.com whl-next)",
        "driver": "AMD Software: Adrenalin Edition 26.11.2（Windows 11 25H2）",
        "devices": ["gfx1201", "gfx1200", "gfx1100", "gfx1101", "gfx1102", "gfx1030", "gfx1103", "gfx1150", "gfx1151", "gfx1152", "gfx1153"],
        "expect": {
          "torch": "2.15.0+rocm10.2.0",
          "torchaudio": "2.11.1+rocm10.2.0"
        },
        "pip_steps": [
          [
            "--no-cache-dir",
            "--index-url",
            "https://stable.repo.amd.com/rocm/whl-next/",
            "torch[device-{device}]==2.15.0+rocm10.2.0",
            "torchaudio==2.11.1+rocm10.2.0"
          ]
        ]
      },
      "rocm-7.2.1": {
        "backend": "amd",
        "label": "AMD ROCm 7.2.1 for Windows / PyTorch 2.9.1 (repo.radeon.com)",
        "driver": "AMD Software: Adrenalin Edition 26.2.2（Windows 11）",
        "devices": ["gfx1201", "gfx1200", "gfx1100", "gfx1101", "gfx1150", "gfx1151"],
        "expect": {
          "torch": "2.9.1+rocm7.2.1",
          "torchaudio": "2.9.1+rocm7.2.1"
        },
        "pip_steps": [
          [
            "--no-cache-dir",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/rocm_sdk_core-7.2.1-py3-none-win_amd64.whl",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/rocm_sdk_devel-7.2.1-py3-none-win_amd64.whl",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/rocm_sdk_libraries_custom-7.2.1-py3-none-win_amd64.whl",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/rocm-7.2.1.tar.gz"
          ],
          [
            "--no-cache-dir",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/torch-2.9.1%2Brocm7.2.1-cp312-cp312-win_amd64.whl",
            "https://repo.radeon.com/rocm/windows/rocm-rel-7.2.1/torchaudio-2.9.1%2Brocm7.2.1-cp312-cp312-win_amd64.whl"
          ]
        ]
      },
      "cu132": {
        "backend": "nvidia",
        "label": "NVIDIA CUDA 13.2 / PyTorch 2.15.0 (download.pytorch.org)",
        "driver": "NVIDIA のドライバ R595 以上（CUDA 13.x の互換で 580 以上でも動く）。GPU は Turing（RTX 20 / GTX 16）以降",
        "min_driver": [580, 0],
        "expect": {
          "torch": "2.15.0+cu132",
          "torchaudio": "2.11.1+cu132"
        },
        "pip_steps": [
          [
            "--no-cache-dir",
            "--index-url",
            "https://download.pytorch.org/whl/cu132",
            "torch==2.15.0+cu132",
            "torchaudio==2.11.1+cu132"
          ]
        ]
      },
      "cu126": {
        "backend": "nvidia",
        "label": "NVIDIA CUDA 12.6 / PyTorch 2.11.0 (download.pytorch.org)",
        "_note": "ドライバを 580 以上にできないとき用。torchaudio 2.11.0 は C 拡張つきで torch 2.11.0 と対なので、torch も 2.11.0 にする",
        "driver": "NVIDIA のドライバ 525 以上（CUDA 12.x の互換）",
        "min_driver": [525, 0],
        "expect": {
          "torch": "2.11.0+cu126",
          "torchaudio": "2.11.0+cu126"
        },
        "pip_steps": [
          [
            "--no-cache-dir",
            "--index-url",
            "https://download.pytorch.org/whl/cu126",
            "torch==2.11.0+cu126",
            "torchaudio==2.11.0+cu126"
          ]
        ]
      },
      "cpu": {
        "backend": "cpu",
        "label": "CPU / PyTorch 2.15.0 (download.pytorch.org)",
        "driver": "",
        "expect": {
          "torch": "2.15.0+cpu",
          "torchaudio": "2.11.1+cpu"
        },
        "pip_steps": [
          [
            "--no-cache-dir",
            "--index-url",
            "https://download.pytorch.org/whl/cpu",
            "torch==2.15.0+cpu",
            "torchaudio==2.11.1+cpu"
          ]
        ]
      }
    }
  }
}
